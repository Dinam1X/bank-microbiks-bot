BOT_TOKEN_BANK=put-bank-bot-token-here

# username (without @) of the company bot, used for the "register here" link
COMPANY_BOT_USERNAME=MicrobRobBot

# Absolute path to the shared db.json also used by the company bot
# (@MicrobRobBot, separate repo/deployment). Both bots MUST point at the same
# file for balances and shares to stay in sync. If unset, defaults to
# ./data/db.json inside this repo (only correct if nothing else uses it).
# MICROB_DB_PATH=/home/user/microb-shared/db.json
